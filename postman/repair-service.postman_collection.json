{"info": {"name": "Ремонт бытовой техники — Задание 3", "description": "CRUD всех сущностей, бизнес-операции (резервирование, списание, завершение, отмена) и проверки отказа. Требуется переменная окружения baseUrl (http://localhost:8080).", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"}, "variable": [{"key": "baseUrl", "value": "http://localhost:8080"}], "item": [{"name": "01 Клиенты (CRUD)", "item": [{"name": "Создать клиента", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{baseUrl}}/api/users", "body": {"mode": "raw", "raw": "{\n  \"name\": \"Иван Петров\",\n  \"email\": \"ivan.petrov@mail.ru\"\n}"}}, "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test(\"Статус 201\", () => pm.response.to.have.status(201));", "pm.environment.set(\"userId\", pm.response.json().id);"]}}]}, {"name": "Список клиентов", "request": {"method": "GET", "url": "{{baseUrl}}/api/users"}, "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test(\"Статус 200\", () => pm.response.to.have.status(200));", "pm.test(\"Список не пуст\", () => pm.expect(pm.response.json().length).to.be.above(0));"]}}]}, {"name": "Клиент по id", "request": {"method": "GET", "url": "{{baseUrl}}/api/users/{{userId}}"}, "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test(\"Статус 200\", () => pm.response.to.have.status(200));", "pm.test(\"Email совпадает\", () => pm.expect(pm.response.json().email).to.eql(\"ivan.petrov@mail.ru\"));"]}}]}, {"name": "Изменить клиента (PATCH)", "request": {"method": "PATCH", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{baseUrl}}/api/users/{{userId}}", "body": {"mode": "raw", "raw": "{ \"name\": \"Иван Петров-мл.\" }"}}, "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test(\"Статус 200\", () => pm.response.to.have.status(200));", "pm.test(\"Имя обновлено\", () => pm.expect(pm.response.json().name).to.eql(\"Иван Петров-мл.\"));"]}}]}]}, {"name": "02 Устройства (CRUD)", "item": [{"name": "Создать устройство", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{baseUrl}}/api/devices", "body": {"mode": "raw", "raw": "{\n  \"ownerId\": {{userId}},\n  \"type\": \"Стиральная машина\",\n  \"model\": \"LG F-1096ND\",\n  \"serialNumber\": \"SN-LG-1001\"\n}"}}, "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test(\"Статус 201\", () => pm.response.to.have.status(201));", "pm.environment.set(\"deviceId\", pm.response.json().id);"]}}]}, {"name": "Список устройств", "request": {"method": "GET", "url": "{{baseUrl}}/api/devices"}, "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test(\"Статус 200\", () => pm.response.to.have.status(200));"]}}]}, {"name": "Ошибка: дубликат серийного номера (409)", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{baseUrl}}/api/devices", "body": {"mode": "raw", "raw": "{\n  \"ownerId\": {{userId}},\n  \"type\": \"Стиральная машина\",\n  \"model\": \"LG F-1096ND\",\n  \"serialNumber\": \"SN-LG-1001\"\n}"}}, "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test(\"Статус 409 (конфликт уникальности)\", () => pm.response.to.have.status(409));"]}}]}, {"name": "Изменить устройство (PATCH)", "request": {"method": "PATCH", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{baseUrl}}/api/devices/{{deviceId}}", "body": {"mode": "raw", "raw": "{ \"model\": \"LG F-1096ND1\" }"}}, "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test(\"Статус 200\", () => pm.response.to.have.status(200));", "pm.test(\"Модель обновлена\", () => pm.expect(pm.response.json().model).to.eql(\"LG F-1096ND1\"));"]}}]}]}, {"name": "03 Запчасти (CRUD)", "item": [{"name": "Создать запчасть", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{baseUrl}}/api/spare-parts", "body": {"mode": "raw", "raw": "{\n  \"name\": \"Подшипник барабана\",\n  \"price\": 1500.00,\n  \"stockQuantity\": 10\n}"}}, "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test(\"Статус 201\", () => pm.response.to.have.status(201));", "const data = pm.response.json();", "pm.environment.set(\"partId\", data.id);", "pm.test(\"Резерв по умолчанию 0\", () => pm.expect(data.reservedQuantity).to.eql(0));"]}}]}, {"name": "Список запчастей", "request": {"method": "GET", "url": "{{baseUrl}}/api/spare-parts"}, "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test(\"Статус 200\", () => pm.response.to.have.status(200));"]}}]}, {"name": "Ошибка: резерв через PATCH запрещён (400)", "request": {"method": "PATCH", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{baseUrl}}/api/spare-parts/{{partId}}", "body": {"mode": "raw", "raw": "{ \"reservedQuantity\": 5 }"}}, "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test(\"Статус 400 (резервом управляет система)\", () => pm.response.to.have.status(400));"]}}]}, {"name": "Изменить цену запчасти (PATCH)", "request": {"method": "PATCH", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{baseUrl}}/api/spare-parts/{{partId}}", "body": {"mode": "raw", "raw": "{ \"price\": 1600.00 }"}}, "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test(\"Статус 200\", () => pm.response.to.have.status(200));", "pm.test(\"Цена обновлена\", () => pm.expect(Number(pm.response.json().price)).to.eql(1600));"]}}]}]}, {"name": "04 Наряды (CRUD)", "item": [{"name": "Создать наряд", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{baseUrl}}/api/repair-orders", "body": {"mode": "raw", "raw": "{\n  \"deviceId\": {{deviceId}},\n  \"fault\": \"Не крутит барабан, гудит подшипник\"\n}"}}, "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test(\"Статус 201\", () => pm.response.to.have.status(201));", "const data = pm.response.json();", "pm.environment.set(\"orderId\", data.id);", "pm.test(\"Новый наряд: NEW и стоимость 0\", () => {", "  pm.expect(data.status).to.eql(\"NEW\");", "  pm.expect(Number(data.cost)).to.eql(0);", "});"]}}]}, {"name": "Список нарядов", "request": {"method": "GET", "url": "{{baseUrl}}/api/repair-orders"}, "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test(\"Статус 200\", () => pm.response.to.have.status(200));"]}}]}, {"name": "Наряд по id", "request": {"method": "GET", "url": "{{baseUrl}}/api/repair-orders/{{orderId}}"}, "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test(\"Статус 200\", () => pm.response.to.have.status(200));"]}}]}, {"name": "Ошибка: статус через PATCH запрещён (400)", "request": {"method": "PATCH", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{baseUrl}}/api/repair-orders/{{orderId}}", "body": {"mode": "raw", "raw": "{ \"status\": \"COMPLETED\" }"}}, "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test(\"Статус 400 (статусом управляют бизнес-операции)\", () => pm.response.to.have.status(400));"]}}]}]}, {"name": "05 Бизнес-операции: полный ремонт", "item": [{"name": "Добавить запчасть в наряд (резерв)", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{baseUrl}}/api/repair-items", "body": {"mode": "raw", "raw": "{\n  \"orderId\": {{orderId}},\n  \"sparePartId\": {{partId}},\n  \"quantity\": 1\n}"}}, "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test(\"Статус 201\", () => pm.response.to.have.status(201));", "const data = pm.response.json();", "pm.environment.set(\"itemId\", data.id);", "pm.test(\"Позиция RESERVED с фиксированной ценой 1500\", () => {", "  pm.expect(data.usageStatus).to.eql(\"RESERVED\");", "  pm.expect(Number(data.fixedPrice)).to.eql(1500);", "});"]}}]}, {"name": "Проверка: резерв запчасти вырос", "request": {"method": "GET", "url": "{{baseUrl}}/api/spare-parts/{{partId}}"}, "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test(\"Статус 200\", () => pm.response.to.have.status(200));", "const data = pm.response.json();", "pm.test(\"reservedQuantity = 1, stock = 10\", () => {", "  pm.expect(data.reservedQuantity).to.eql(1);", "  pm.expect(data.stockQuantity).to.eql(10);", "});"]}}]}, {"name": "Ошибка: недостаточно склада (409)", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{baseUrl}}/api/repair-items", "body": {"mode": "raw", "raw": "{\n  \"orderId\": {{orderId}},\n  \"sparePartId\": {{partId}},\n  \"quantity\": 100\n}"}}, "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test(\"Статус 409 (не хватает остатка)\", () => pm.response.to.have.status(409));"]}}]}, {"name": "Приёмка в работу (/start)", "request": {"method": "POST", "url": "{{baseUrl}}/api/repair-orders/{{orderId}}/start"}, "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test(\"Статус 200\", () => pm.response.to.have.status(200));", "pm.test(\"Статус наряда IN_PROGRESS\", () => pm.expect(pm.response.json().status).to.eql(\"IN_PROGRESS\"));"]}}]}, {"name": "Ошибка: завершить с незакрытым резервом (409)", "request": {"method": "POST", "url": "{{baseUrl}}/api/repair-orders/{{orderId}}/complete"}, "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test(\"Статус 409 (резерв не закрыт)\", () => pm.response.to.have.status(409));"]}}]}, {"name": "Списание запчасти (/use)", "request": {"method": "POST", "url": "{{baseUrl}}/api/repair-items/{{itemId}}/use"}, "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test(\"Статус 200\", () => pm.response.to.have.status(200));", "pm.test(\"Позиция USED\", () => pm.expect(pm.response.json().usageStatus).to.eql(\"USED\"));"]}}]}, {"name": "Проверка: склад уменьшился", "request": {"method": "GET", "url": "{{baseUrl}}/api/spare-parts/{{partId}}"}, "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test(\"Статус 200\", () => pm.response.to.have.status(200));", "const data = pm.response.json();", "pm.test(\"stock = 9, reserved = 0\", () => {", "  pm.expect(data.stockQuantity).to.eql(9);", "  pm.expect(data.reservedQuantity).to.eql(0);", "});"]}}]}, {"name": "Ошибка: повторное списание (409)", "request": {"method": "POST", "url": "{{baseUrl}}/api/repair-items/{{itemId}}/use"}, "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test(\"Статус 409 (уже списана)\", () => pm.response.to.have.status(409));"]}}]}, {"name": "Завершение ремонта (/complete)", "request": {"method": "POST", "url": "{{baseUrl}}/api/repair-orders/{{orderId}}/complete"}, "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test(\"Статус 200\", () => pm.response.to.have.status(200));", "const data = pm.response.json();", "pm.test(\"COMPLETED со стоимостью 1500\", () => {", "  pm.expect(data.status).to.eql(\"COMPLETED\");", "  pm.expect(Number(data.cost)).to.eql(1500);", "});"]}}]}, {"name": "Ошибка: позиция в завершённый наряд (409)", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{baseUrl}}/api/repair-items", "body": {"mode": "raw", "raw": "{\n  \"orderId\": {{orderId}},\n  \"sparePartId\": {{partId}},\n  \"quantity\": 1\n}"}}, "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test(\"Статус 409 (наряд завершён)\", () => pm.response.to.have.status(409));"]}}]}]}, {"name": "06 Бизнес-операции: отмена заказа", "item": [{"name": "Создать второй наряд", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{baseUrl}}/api/repair-orders", "body": {"mode": "raw", "raw": "{\n  \"deviceId\": {{deviceId}},\n  \"fault\": \"Протечка снизу\"\n}"}}, "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test(\"Статус 201\", () => pm.response.to.have.status(201));", "pm.environment.set(\"orderId2\", pm.response.json().id);"]}}]}, {"name": "Зарезервировать 2 запчасти", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{baseUrl}}/api/repair-items", "body": {"mode": "raw", "raw": "{\n  \"orderId\": {{orderId2}},\n  \"sparePartId\": {{partId}},\n  \"quantity\": 2\n}"}}, "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test(\"Статус 201\", () => pm.response.to.have.status(201));", "pm.environment.set(\"itemId2\", pm.response.json().id);"]}}]}, {"name": "Отменить заказ (/cancel)", "request": {"method": "POST", "url": "{{baseUrl}}/api/repair-orders/{{orderId2}}/cancel"}, "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test(\"Статус 200\", () => pm.response.to.have.status(200));", "pm.test(\"Статус наряда CANCELLED\", () => pm.expect(pm.response.json().status).to.eql(\"CANCELLED\"));"]}}]}, {"name": "Проверка: резерв вернулся на склад", "request": {"method": "GET", "url": "{{baseUrl}}/api/spare-parts/{{partId}}"}, "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test(\"Статус 200\", () => pm.response.to.have.status(200));", "const data = pm.response.json();", "pm.test(\"stock = 9, reserved = 0\", () => {", "  pm.expect(data.stockQuantity).to.eql(9);", "  pm.expect(data.reservedQuantity).to.eql(0);", "});"]}}]}, {"name": "Проверка: позиция стала CANCELLED", "request": {"method": "GET", "url": "{{baseUrl}}/api/repair-items/{{itemId2}}"}, "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test(\"Статус 200\", () => pm.response.to.have.status(200));", "pm.test(\"usageStatus = CANCELLED\", () => pm.expect(pm.response.json().usageStatus).to.eql(\"CANCELLED\"));"]}}]}]}, {"name": "07 Каскадное удаление", "item": [{"name": "Удалить клиента (со всеми устройствами и нарядами)", "request": {"method": "DELETE", "url": "{{baseUrl}}/api/users/{{userId}}"}, "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test(\"Статус 204\", () => pm.response.to.have.status(204));"]}}]}, {"name": "Проверка: устройство удалено", "request": {"method": "GET", "url": "{{baseUrl}}/api/devices/{{deviceId}}"}, "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test(\"Статус 404\", () => pm.response.to.have.status(404));"]}}]}, {"name": "Проверка: наряд удалён", "request": {"method": "GET", "url": "{{baseUrl}}/api/repair-orders/{{orderId}}"}, "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test(\"Статус 404\", () => pm.response.to.have.status(404));"]}}]}, {"name": "Проверка: запчасть осталась, резерв освобождён", "request": {"method": "GET", "url": "{{baseUrl}}/api/spare-parts/{{partId}}"}, "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test(\"Статус 200\", () => pm.response.to.have.status(200));", "pm.test(\"reserved = 0\", () => pm.expect(pm.response.json().reservedQuantity).to.eql(0));"]}}]}]}]}
